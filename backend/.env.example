DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/book_platform
SECRET_KEY=super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

ENVIRONMENT=development
APP_NAME=Book Platform API
DEBUG=true

# MinIO / S3 para archivos
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_COVERS=book-covers
STORAGE_BUCKET_AVATARS=user-avatars
STORAGE_USE_SSL=false

# CORS
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4202
