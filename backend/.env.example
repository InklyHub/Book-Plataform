DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/book_platform
SECRET_KEY=super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

ENVIRONMENT=development
APP_NAME=Book Platform API
DEBUG=true

# MinIO / S3 para archivos
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_COVERS=book-covers
STORAGE_BUCKET_AVATARS=user-avatars
STORAGE_USE_SSL=false

# CORS
ALLOWED_ORIGINS=["http://localhost:4200","http://localhost:4202"]

# Email (Resend) — obtén tu API key en https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Sin dominio propio: usa onboarding@resend.dev (solo envía al email de tu cuenta Resend)
# Con dominio verificado: usa noreply@tudominio.com
RESEND_FROM_EMAIL=onboarding@resend.dev
FRONTEND_URL=http://localhost:4200
